local function createToggle(Page, Name)

    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(1, -8, 0, 47)
    Button.BackgroundColor3 = Color3.fromRGB(38, 38, 53)
    Button.BorderSizePixel = 0
    Button.AutoButtonColor = false
    Button.Font = Enum.Font.GothamBold
    Button.TextSize = 12
    Button.TextColor3 = Color3.new(1, 1, 1)
    Button.Parent = Page

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 9)
    Corner.Parent = Button

    local Stroke = Instance.new("UIStroke")
    Stroke.Thickness = 1
    Stroke.Transparency = 0.65
    Stroke.Parent = Button

    addRGB(Stroke, math.random())

    local Indicator = Instance.new("Frame")
    Indicator.Size = UDim2.fromOffset(6, 25)
    Indicator.Position = UDim2.fromOffset(9, 11)
    Indicator.BackgroundColor3 = Color3.fromRGB(75, 75, 95)
    Indicator.BorderSizePixel = 0
    Indicator.Parent = Button

    local IndicatorCorner = Instance.new("UICorner")
    IndicatorCorner.CornerRadius = UDim.new(1, 0)
    IndicatorCorner.Parent = Indicator

    local function update()

        if Settings[Name] then

            Button.Text =
                DisplayNames[Name] .. "   ON"

            Button.BackgroundColor3 =
                Color3.fromRGB(31, 115, 67)

            Indicator.BackgroundColor3 =
                Color3.fromRGB(90, 255, 135)

        else

            Button.Text =
                DisplayNames[Name] .. "   OFF"

            Button.BackgroundColor3 =
                Color3.fromRGB(38, 38, 53)

            Indicator.BackgroundColor3 =
                Color3.fromRGB(75, 75, 95)

        end

    end

    Button.MouseButton1Click:Connect(function()

        Settings[Name] = not Settings[Name]

        update()

    end)

    update()

    return Button
end

