local EggMultiplier = 1.00

RemoteEvent.OnClientEvent:Connect(function(EventName, Data)

    if EventName ~= "UI-Notification" then
        return
    end

    if type(Data) ~= "table" or type(Data.Text) ~= "string" then
        return
    end

    local Text = Data.Text

    -- Matches:
    -- "Egg Multiplier rose to 1.00x!"
    -- "Egg Multiplier rose to 1.25x!"
    -- etc.
    local Multiplier = Text:match(
        "Egg%s+Multiplier%s+rose%s+to%s+([%d%.]+)x"
    )

    if Multiplier then
        EggMultiplier = tonumber(Multiplier) or EggMultiplier

        print(
            "🥚 Egg Multiplier:",
            string.format("%.2fx", EggMultiplier)
        )
    end

end)

