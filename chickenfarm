--==================================================
-- EGG OPTIMIZATION
--==================================================

local Collecting = {}
local HiddenEggs = {}

local function getEggId(Egg)
    if not Egg then
        return nil
    end

    return Egg:GetAttribute("Id")
        or Egg:GetAttribute("EggId")
        or Egg:GetAttribute("EggID")
        or Egg.Name
end

local function hideEgg(Egg)
    if not Egg or not Egg.Parent then
        return
    end

    if HiddenEggs[Egg] then
        return
    end

    HiddenEggs[Egg] = true

    if Egg:IsA("BasePart") then
        Egg.LocalTransparencyModifier = 1
        Egg.CanCollide = false
        Egg.CanTouch = false
        Egg.CanQuery = false
    end

    for _, Object in ipairs(Egg:GetDescendants()) do

        if Object:IsA("BasePart") then
            Object.LocalTransparencyModifier = 1
            Object.CanCollide = false
            Object.CanTouch = false
            Object.CanQuery = false

        elseif Object:IsA("ProximityPrompt") then
            Object.Enabled = false

        elseif Object:IsA("ParticleEmitter")
            or Object:IsA("Trail")
            or Object:IsA("Beam") then

            Object.Enabled = false
        end
    end
end

local function collectEgg(Egg)

    if not Settings.AutoCollectEggs then
        return
    end

    if not Egg or not Egg.Parent then
        return
    end

    if Collecting[Egg] or HiddenEggs[Egg] then
        return
    end

    local EggId = getEggId(Egg)

    if not EggId or EggId == "" then
        return
    end

    Collecting[Egg] = true

    -- Hide locally immediately.
    hideEgg(Egg)

    pcall(function()
        RemoteEvent:FireServer("Collect Egg", EggId)
    end)

    task.delay(0.75, function()
        Collecting[Egg] = nil
    end)
end

task.spawn(function()

    while task.wait(0.2) do

        if Settings.AutoCollectEggs then

            for _, Egg in ipairs(EggsFolder:GetChildren()) do

                if Egg.Parent and not HiddenEggs[Egg] then
                    collectEgg(Egg)
                end

            end

        end

    end

end)

EggsFolder.ChildAdded:Connect(function(Egg)

    if Settings.AutoCollectEggs then

        task.defer(function()

            if Egg.Parent then
                collectEgg(Egg)
            end

        end)

    end

end)

EggsFolder.ChildRemoved:Connect(function(Egg)

    Collecting[Egg] = nil
    HiddenEggs[Egg] = nil

end)

