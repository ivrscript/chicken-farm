local function createToggle(Name)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(1, -10, 0, 52)
    Button.BackgroundColor3 = Color3.fromRGB(39, 39, 53)
    Button.BorderSizePixel = 0
    Button.AutoButtonColor = false
    Button.Font = Enum.Font.GothamBold
    Button.TextSize = 13
    Button.TextColor3 = Color3.new(1, 1, 1)
    Button.Parent = Scroll

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 11)
    Corner.Parent = Button

    local Stroke = Instance.new("UIStroke")
    Stroke.Thickness = 1
    Stroke.Transparency = 0.65
    Stroke.Parent = Button

    addRGB(Stroke, math.random())

    local Indicator = Instance.new("Frame")
    Indicator.Size = UDim2.fromOffset(7, 30)
    Indicator.Position = UDim2.fromOffset(10, 11)
    Indicator.BackgroundColor3 = Color3.fromRGB(80, 80, 100)
    Indicator.BorderSizePixel = 0
    Indicator.Parent = Button

    local IndicatorCorner = Instance.new("UICorner")
    IndicatorCorner.CornerRadius = UDim.new(1, 0)
    IndicatorCorner.Parent = Indicator

    local function Update()
        if Settings[Name] then
            Button.Text = DisplayNames[Name] .. "   ON"

            TweenService:Create(
                Button,
                TweenInfo.new(0.15),
                {BackgroundColor3 = Color3.fromRGB(32, 135, 75)}
            ):Play()

            TweenService:Create(
                Indicator,
                TweenInfo.new(0.15),
                {BackgroundColor3 = Color3.fromRGB(100, 255, 145)}
            ):Play()
        else
            Button.Text = DisplayNames[Name] .. "   OFF"

            TweenService:Create(
                Button,
                TweenInfo.new(0.15),
                {BackgroundColor3 = Color3.fromRGB(39, 39, 53)}
            ):Play()

            TweenService:Create(
                Indicator,
                TweenInfo.new(0.15),
                {BackgroundColor3 = Color3.fromRGB(80, 80, 100)}
            ):Play()
        end
    end

    Button.MouseButton1Click:Connect(function()
        Settings[Name] = not Settings[Name]
        Update()
    end)

    Update()

    return Button
end

